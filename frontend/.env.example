# ==============================================================================
# SECURETASK PRO - FRONTEND ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' in your local development workspace.

# 1. Backend API Base URL
# - Local Development: http://localhost:5000/api/v1
# - Production Deployment: https://securetask-pro-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# 2. Third-Party Credentials
# Google OAuth 2.0 Client ID (matching backend config).
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
