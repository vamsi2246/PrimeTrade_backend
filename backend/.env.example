# ==============================================================================
# SECURETASK PRO - BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your values. Do NOT commit the '.env' file.

# 1. Server Configuration
# Port for the Express server to listen on. Render defaults to 10000 or dynamically assigns.
PORT=5000

# Environment mode. Set to 'production' on your Render/Production server.
NODE_ENV=development

# 2. Database & Cache Connection Strings
# MongoDB connection URI. 
# - Local: mongodb://localhost:27017/securetaskpro
# - Production (Atlas): mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/securetaskpro?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/securetaskpro

# Redis connection URL. Used for rate limit and auth caching.
# - Local: redis://localhost:6379
# - Production (Upstash/Render Redis): rediss://red-xxxxxxxxxx:password@host:port
REDIS_URL=redis://localhost:6379

# 3. Cryptography & Security Secrets
# Use a strong, long, random string (e.g., openssl rand -base64 32)
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Access token expiry (e.g., 15m, 1h)
JWT_EXPIRE=15m

# 4. CORS Setup
# The URL of your front-end application (Vercel) to restrict API access.
# - Local: http://localhost:5173
# - Production: https://securetask-pro.vercel.app
CLIENT_URL=http://localhost:5173

# 5. Third-Party Integrations
# Google OAuth 2.0 Client Credentials for SSO authentication.
GOOGLE_CLIENT_ID=your_google_client_id_here
